<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      Deliberately has no parent: importing this BOM must only bring in Halyx's own
      artifacts, not the cloud SDK BOMs managed by halyx-parent. The one exception is the
      Cloud SQL connector, which applications declare themselves.
    -->
    <groupId>dev.halyx</groupId>
    <artifactId>halyx-bom</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Halyx :: BOM</name>
    <description>Halyx, the multi-cloud Java library: bill of materials that aligns the versions of every Halyx module, and of the Cloud SQL connector an application adds for SQL on Google Cloud.</description>

    <licenses>
        <license>
            <name>Apache-2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <!-- Repeated from halyx-parent, which this BOM deliberately doesn't inherit. -->
    <url>https://halyx.dev</url>

    <developers>
        <developer>
            <id>kamranzafar</id>
            <name>Kamran Zafar</name>
            <email>kamran@kamranzafar.org</email>
            <url>https://github.com/kamranzafar</url>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/halyx-dev/halyx.git</connection>
        <developerConnection>scm:git:git@github.com:halyx-dev/halyx.git</developerConnection>
        <url>https://github.com/halyx-dev/halyx</url>
        <tag>HEAD</tag>
    </scm>

    <properties>
        <!-- Kept in step with halyx-parent's cloud-sql-connector.version, the one Halyx is tested with -->
        <cloud-sql-connector.version>1.30.0</cloud-sql-connector.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>dev.halyx</groupId>
                <artifactId>halyx-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.halyx</groupId>
                <artifactId>halyx-tck</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.halyx</groupId>
                <artifactId>halyx-redis</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.halyx</groupId>
                <artifactId>halyx-sql</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.halyx</groupId>
                <artifactId>halyx-kafka</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.halyx</groupId>
                <artifactId>halyx-aws</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.halyx</groupId>
                <artifactId>halyx-azure</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.halyx</groupId>
                <artifactId>halyx-gcp</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.halyx</groupId>
                <artifactId>halyx-vault</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.halyx</groupId>
                <artifactId>halyx-r2dbc</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.halyx</groupId>
                <artifactId>halyx-reactor</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.halyx</groupId>
                <artifactId>halyx-micrometer</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.halyx</groupId>
                <artifactId>halyx-spring-data-document</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.halyx</groupId>
                <artifactId>halyx-spring-boot-autoconfigure</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.halyx</groupId>
                <artifactId>halyx-spring-boot-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!--
              The Cloud SQL connector, which an application adds at runtime scope for SQL on Google Cloud through
              halyx.databases.*.properties.gcp.sql.instance: the version Halyx is tested with.
            -->
            <dependency>
                <groupId>com.google.cloud.sql</groupId>
                <artifactId>postgres-socket-factory</artifactId>
                <version>${cloud-sql-connector.version}</version>
            </dependency>
            <dependency>
                <groupId>com.google.cloud.sql</groupId>
                <artifactId>mysql-socket-factory-connector-j-8</artifactId>
                <version>${cloud-sql-connector.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- The parent's release profile, less the source and javadoc jars a POM doesn't have. -->
    <profiles>
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.8</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.12.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central-halyx</publishingServerId>
                            <autoPublish>false</autoPublish>
                            <deploymentName>Halyx ${project.version}</deploymentName>
                            <!-- The plugin ignores maven.deploy.skip, so the unpublished modules are listed here. -->
                            <excludeArtifacts>
                                <excludeArtifact>halyx-reactor-tests</excludeArtifact>
                                <excludeArtifact>halyx-spring-boot4-tests</excludeArtifact>
                                <excludeArtifact>halyx-benchmarks</excludeArtifact>
                                <excludeArtifact>halyx-samples</excludeArtifact>
                                <excludeArtifact>portable-orders</excludeArtifact>
                                <excludeArtifact>portable-orders-boot3</excludeArtifact>
                            </excludeArtifacts>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
