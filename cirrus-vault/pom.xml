<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.kamranzafar.cirrus</groupId>
        <artifactId>cirrus-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>cirrus-vault</artifactId>
    <name>Cirrus :: HashiCorp Vault</name>
    <description>
        Cirrus provider for HashiCorp Vault: parameters and secrets on the KV v2 engine. Uses the JDK
        HTTP client and a built-in JSON codec, so it adds no third-party dependencies that could clash
        with the cloud SDKs (Azure, for one, rejects mismatched Jackson versions).
    </description>

    <dependencies>
        <dependency>
            <groupId>org.kamranzafar.cirrus</groupId>
            <artifactId>cirrus-core</artifactId>
        </dependency>

        <dependency>
            <groupId>org.kamranzafar.cirrus</groupId>
            <artifactId>cirrus-tck</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
