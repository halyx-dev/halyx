  # The versions Boot 3.5 manages, which the auto-configuration and the starter test against on purpose. Halyx's own
  # modules bring the patched versions; a Boot 3.5 application gets Boot's unless it overrides them, as the Boot 3.5
  # sample shows.
  SNYK-JAVA-IOPROJECTREACTOR-19267101:
