<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.kamranzafar</groupId>
        <artifactId>cirrus-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>cirrus-gcp</artifactId>
    <name>Cirrus :: GCP</name>
    <description>Cirrus provider for GCP.</description>

    <dependencies>
        <dependency>
            <groupId>org.kamranzafar</groupId>
            <artifactId>cirrus-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.google.cloud</groupId>
            <artifactId>google-cloud-storage</artifactId>
        </dependency>
        <!-- Pooled Apache transport for GCS; the default HttpURLConnection keeps only 5 idle connections -->
        <dependency>
            <groupId>com.google.http-client</groupId>
            <artifactId>google-http-client-apache-v2</artifactId>
        </dependency>
        <!-- Apache HttpClient 4 logs through commons-logging, which Google excludes; 1.3 routes to SLF4J -->
        <dependency>
            <groupId>commons-logging</groupId>
            <artifactId>commons-logging</artifactId>
        </dependency>
        <!-- Secrets -->
        <dependency>
            <groupId>com.google.cloud</groupId>
            <artifactId>google-cloud-secretmanager</artifactId>
        </dependency>
        <!-- NoSQL -->
        <dependency>
            <groupId>com.google.cloud</groupId>
            <artifactId>google-cloud-firestore</artifactId>
        </dependency>
        <!-- Messaging -->
        <dependency>
            <groupId>com.google.cloud</groupId>
            <artifactId>google-cloud-pubsub</artifactId>
        </dependency>
        <dependency>
            <groupId>com.google.cloud</groupId>
            <artifactId>google-cloud-parametermanager</artifactId>
        </dependency>
        <!-- Caches: shared Redis driver, with IAM access tokens for Memorystore -->
        <dependency>
            <groupId>org.kamranzafar</groupId>
            <artifactId>cirrus-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.kamranzafar</groupId>
            <artifactId>cirrus-sql</artifactId>
        </dependency>
        <!-- Tests: TCK against the Floci emulator in Docker (run with mvn verify) -->
        <dependency>
            <groupId>org.kamranzafar</groupId>
            <artifactId>cirrus-tck</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Fake Parameter Manager gRPC server for tests (there is no emulator) -->
        <dependency>
            <groupId>com.google.api.grpc</groupId>
            <artifactId>grpc-google-cloud-parametermanager-v1</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
