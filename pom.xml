<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>dev.halyx</groupId>
    <artifactId>halyx-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Halyx :: Parent</name>
    <description>Halyx: one Java API for storage, NoSQL, messaging, streams, SQL, caches and secrets on AWS, Azure and Google Cloud — a portable library over the clouds' own SDKs.</description>

    <licenses>
        <license>
            <name>Apache-2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <modules>
        <module>halyx-bom</module>
        <module>halyx-core</module>
        <module>halyx-tck</module>
        <module>halyx-redis</module>
        <module>halyx-sql</module>
        <module>halyx-r2dbc</module>
        <module>halyx-reactor</module>
        <module>halyx-micrometer</module>
        <module>halyx-kafka</module>
        <module>halyx-aws</module>
        <module>halyx-azure</module>
        <module>halyx-gcp</module>
        <module>halyx-vault</module>
        <module>halyx-spring-data-document</module>
        <module>halyx-spring-boot-autoconfigure</module>
        <module>halyx-spring-boot-starter</module>
        <module>halyx-spring-boot4-tests</module>
        <module>halyx-reactor-tests</module>
        <module>halyx-benchmarks</module>
    </modules>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Cloud SDKs (managed through their own BOMs) -->
        <aws-sdk.version>2.55.14</aws-sdk.version>
        <azure-sdk-bom.version>1.3.8</azure-sdk-bom.version>
        <gcp-libraries-bom.version>26.90.0</gcp-libraries-bom.version>
        <!-- Not in libraries-bom yet; 0.43.0 is from the same google-cloud-java release (1.93.0) -->
        <gcp-parametermanager.version>0.43.0</gcp-parametermanager.version>
        <!-- Needed by the Apache HTTP transport, which Google's BOM ships without it; same as Spring 7 -->
        <commons-logging.version>1.3.6</commons-logging.version>

        <!--
          Spring Boot, imported only by the Spring modules so it never changes SDK dependency versions.
          The auto-configuration is compiled against the oldest supported line (3.5) and tested on both.
        -->
        <spring-boot3.version>3.5.16</spring-boot3.version>
        <spring-boot4.version>4.1.1</spring-boot4.version>
        <!-- Jackson 3 (tools.jackson), Boot 4's JSON library; compile-only for the cache codec -->
        <jackson3.version>3.1.5</jackson3.version>

        <!-- Redis/Valkey client: the 6.x line stays on Netty 4.1, like the AWS and Azure SDKs -->
        <lettuce.version>6.8.2.RELEASE</lettuce.version>
        <!-- SQL: the pool Spring Boot 3.5 ships (Boot 4 brings 7.x, which is API compatible), and test drivers -->
        <hikaricp.version>6.3.3</hikaricp.version>
        <!-- R2DBC, as Spring Boot 3.5 manages it; Boot 4 applications get their own -->
        <r2dbc-spi.version>1.0.0.RELEASE</r2dbc-spi.version>
        <r2dbc-pool.version>1.0.2.RELEASE</r2dbc-pool.version>
        <r2dbc-postgresql.version>1.0.9.RELEASE</r2dbc-postgresql.version>
        <r2dbc-mysql.version>1.4.2</r2dbc-mysql.version>
        <r2dbc-mssql.version>1.0.4.RELEASE</r2dbc-mssql.version>
        <reactor-core.version>3.7.9</reactor-core.version>
        <context-propagation.version>1.1.4</context-propagation.version>
        <rxjava.version>3.1.8</rxjava.version>
        <mutiny.version>2.6.0</mutiny.version>
        <!--
          Reactor Netty's core and HTTP modules must match: the Azure SDK brings reactor-netty-http 1.2, the R2DBC
          drivers reactor-netty-core 1.1, and a mix fails with IncompatibleClassChangeError.
        -->
        <reactor-netty.version>1.2.18</reactor-netty.version>
        <!-- The R2DBC drivers Spring Boot 4.1 manages, for the Boot 4 tests -->
        <r2dbc-postgresql4.version>1.1.2.RELEASE</r2dbc-postgresql4.version>
        <!-- Kafka clients: the version Spring Boot 3.5 manages; applications' Boot BOMs choose their own -->
        <kafka.version>3.9.2</kafka.version>
        <!-- The Kafka clients Spring Boot 4.1 manages, for the Boot 4 tests -->
        <kafka4.version>4.2.1</kafka4.version>
        <postgresql.version>42.7.11</postgresql.version>
        <mysql-connector-j.version>9.7.0</mysql-connector-j.version>
        <mssql-jdbc.version>12.10.2.jre11</mssql-jdbc.version>
        <cloud-sql-connector.version>1.30.0</cloud-sql-connector.version>
        <valkey.image>valkey/valkey:9.1.2-alpine</valkey.image>
        <vault.image>hashicorp/vault:2.1.2</vault.image>
        <kafka.image>apache/kafka:3.9.1</kafka.image>
        <!-- halyx-kafka also runs its broker tests on Kafka 4 -->
        <kafka4.image>apache/kafka:4.2.1</kafka4.image>

        <!-- Common -->
        <slf4j.version>2.0.20</slf4j.version>

        <!-- Test -->
        <junit.version>6.1.3</junit.version>
        <assertj.version>3.27.7</assertj.version>
        <testcontainers.version>2.0.5</testcontainers.version>

        <!-- Floci emulator images used by the provider integration tests -->
        <floci.aws.image>floci/floci:2.2.0</floci.aws.image>
        <floci.azure.image>floci/floci-az:0.14.0</floci.azure.image>
        <floci.gcp.image>floci/floci-gcp:0.10.0</floci.gcp.image>

        <!-- Plugins -->
        <maven-compiler-plugin.version>3.15.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.5.6</maven-surefire-plugin.version>
        <maven-failsafe-plugin.version>3.5.6</maven-failsafe-plugin.version>
        <maven-jar-plugin.version>3.5.0</maven-jar-plugin.version>
        <maven-enforcer-plugin.version>3.6.3</maven-enforcer-plugin.version>
        <build-helper-maven-plugin.version>3.6.2</build-helper-maven-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Halyx modules -->
            <dependency>
                <groupId>dev.halyx</groupId>
                <artifactId>halyx-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.halyx</groupId>
                <artifactId>halyx-tck</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.halyx</groupId>
                <artifactId>halyx-redis</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.halyx</groupId>
                <artifactId>halyx-sql</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.halyx</groupId>
                <artifactId>halyx-kafka</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.halyx</groupId>
                <artifactId>halyx-micrometer</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.halyx</groupId>
                <artifactId>halyx-aws</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.halyx</groupId>
                <artifactId>halyx-azure</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.halyx</groupId>
                <artifactId>halyx-spring-data-document</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.halyx</groupId>
                <artifactId>halyx-r2dbc</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.halyx</groupId>
                <artifactId>halyx-reactor</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.halyx</groupId>
                <artifactId>halyx-gcp</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.google.cloud</groupId>
                <artifactId>google-cloud-parametermanager</artifactId>
                <version>${gcp-parametermanager.version}</version>
            </dependency>
            <dependency>
                <groupId>com.google.api.grpc</groupId>
                <artifactId>grpc-google-cloud-parametermanager-v1</artifactId>
                <version>${gcp-parametermanager.version}</version>
            </dependency>
            <dependency>
                <groupId>commons-logging</groupId>
                <artifactId>commons-logging</artifactId>
                <version>${commons-logging.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.kafka</groupId>
                <artifactId>kafka-clients</artifactId>
                <version>${kafka.version}</version>
            </dependency>
            <dependency>
                <groupId>com.zaxxer</groupId>
                <artifactId>HikariCP</artifactId>
                <version>${hikaricp.version}</version>
            </dependency>
            <dependency>
                <groupId>io.r2dbc</groupId>
                <artifactId>r2dbc-spi</artifactId>
                <version>${r2dbc-spi.version}</version>
            </dependency>
            <dependency>
                <groupId>io.r2dbc</groupId>
                <artifactId>r2dbc-pool</artifactId>
                <version>${r2dbc-pool.version}</version>
            </dependency>
            <dependency>
                <groupId>org.postgresql</groupId>
                <artifactId>r2dbc-postgresql</artifactId>
                <version>${r2dbc-postgresql.version}</version>
            </dependency>
            <dependency>
                <groupId>io.asyncer</groupId>
                <artifactId>r2dbc-mysql</artifactId>
                <version>${r2dbc-mysql.version}</version>
            </dependency>
            <dependency>
                <groupId>io.r2dbc</groupId>
                <artifactId>r2dbc-mssql</artifactId>
                <version>${r2dbc-mssql.version}</version>
            </dependency>
            <dependency>
                <groupId>io.projectreactor</groupId>
                <artifactId>reactor-core</artifactId>
                <version>${reactor-core.version}</version>
            </dependency>
            <dependency>
                <groupId>io.projectreactor</groupId>
                <artifactId>reactor-test</artifactId>
                <version>${reactor-core.version}</version>
            </dependency>
            <dependency>
                <groupId>io.micrometer</groupId>
                <artifactId>context-propagation</artifactId>
                <version>${context-propagation.version}</version>
            </dependency>
            <!-- Interoperability tests of halyx-reactor -->
            <dependency>
                <groupId>io.reactivex.rxjava3</groupId>
                <artifactId>rxjava</artifactId>
                <version>${rxjava.version}</version>
            </dependency>
            <dependency>
                <groupId>io.smallrye.reactive</groupId>
                <artifactId>mutiny</artifactId>
                <version>${mutiny.version}</version>
            </dependency>
            <dependency>
                <groupId>io.projectreactor.netty</groupId>
                <artifactId>reactor-netty-core</artifactId>
                <version>${reactor-netty.version}</version>
            </dependency>
            <dependency>
                <groupId>io.projectreactor.netty</groupId>
                <artifactId>reactor-netty-http</artifactId>
                <version>${reactor-netty.version}</version>
            </dependency>
            <dependency>
                <groupId>org.postgresql</groupId>
                <artifactId>postgresql</artifactId>
                <version>${postgresql.version}</version>
            </dependency>
            <dependency>
                <groupId>com.mysql</groupId>
                <artifactId>mysql-connector-j</artifactId>
                <version>${mysql-connector-j.version}</version>
            </dependency>
            <dependency>
                <groupId>com.microsoft.sqlserver</groupId>
                <artifactId>mssql-jdbc</artifactId>
                <version>${mssql-jdbc.version}</version>
            </dependency>
            <dependency>
                <groupId>com.google.cloud.sql</groupId>
                <artifactId>postgres-socket-factory</artifactId>
                <version>${cloud-sql-connector.version}</version>
            </dependency>
            <dependency>
                <groupId>com.google.cloud.sql</groupId>
                <artifactId>mysql-socket-factory-connector-j-8</artifactId>
                <version>${cloud-sql-connector.version}</version>
            </dependency>
            <dependency>
                <groupId>io.lettuce</groupId>
                <artifactId>lettuce-core</artifactId>
                <version>${lettuce.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.halyx</groupId>
                <artifactId>halyx-spring-boot-autoconfigure</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.halyx</groupId>
                <artifactId>halyx-vault</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Cloud SDK BOMs -->
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${aws-sdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.azure</groupId>
                <artifactId>azure-sdk-bom</artifactId>
                <version>${azure-sdk-bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.google.cloud</groupId>
                <artifactId>libraries-bom</artifactId>
                <version>${gcp-libraries-bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Test BOMs -->
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-api</artifactId>
                <version>${slf4j.version}</version>
            </dependency>
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-simple</artifactId>
                <version>${slf4j.version}</version>
            </dependency>
            <dependency>
                <groupId>org.assertj</groupId>
                <artifactId>assertj-core</artifactId>
                <version>${assertj.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                        <parameters>true</parameters>
                        <compilerArgs>
                            <arg>-Xlint:all,-processing,-serial</arg>
                        </compilerArgs>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>${maven-failsafe-plugin.version}</version>
                    <configuration>
                        <systemPropertyVariables>
                            <floci.aws.image>${floci.aws.image}</floci.aws.image>
                            <floci.azure.image>${floci.azure.image}</floci.azure.image>
                            <floci.gcp.image>${floci.gcp.image}</floci.gcp.image>
                            <valkey.image>${valkey.image}</valkey.image>
                            <vault.image>${vault.image}</vault.image>
                            <kafka.image>${kafka.image}</kafka.image>
                        </systemPropertyVariables>
                    </configuration>
                    <executions>
                        <execution>
                            <goals>
                                <goal>integration-test</goal>
                                <goal>verify</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>${maven-jar-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <version>${maven-enforcer-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>build-helper-maven-plugin</artifactId>
                    <version>${build-helper-maven-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!-- Every source file carries the Apache-2.0 header. One run from the root covers the whole tree
                 (halyx-bom included); `mvn license:format` adds missing headers, and the build fails without them. -->
            <plugin>
                <groupId>com.mycila</groupId>
                <artifactId>license-maven-plugin</artifactId>
                <version>5.1.2</version>
                <inherited>false</inherited>
                <configuration>
                    <aggregate>true</aggregate>
                    <!-- The built-in excludes skip META-INF/services; the includes below are explicit anyway. -->
                    <defaultUseDefaultExcludes>false</defaultUseDefaultExcludes>
                    <licenseSets>
                        <licenseSet>
                            <inlineHeader><![CDATA[Copyright 2026 Kamran Zafar

Licensed under the Apache License, Version 2.0 (the "License");
you may not use this file except in compliance with the License.
You may obtain a copy of the License at

    http://www.apache.org/licenses/LICENSE-2.0

Unless required by applicable law or agreed to in writing, software
distributed under the License is distributed on an "AS IS" BASIS,
WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
See the License for the specific language governing permissions and
limitations under the License.]]></inlineHeader>
                            <includes>
                                <include>**/*.java</include>
                                <include>**/pom.xml</include>
                                <include>**/*.sh</include>
                                <include>**/*.tf</include>
                                <include>**/*.yml</include>
                                <include>**/META-INF/services/*</include>
                                <include>**/META-INF/spring.factories</include>
                                <include>**/META-INF/spring/*.imports</include>
                            </includes>
                            <excludes>
                                <exclude>**/target/**</exclude>
                                <exclude>**/.terraform/**</exclude>
                                <exclude>graphify-out/**</exclude>
                                <exclude>**/.git/**</exclude>
                                <exclude>**/.idea/**</exclude>
                            </excludes>
                        </licenseSet>
                    </licenseSets>
                    <mapping>
                        <java>SLASHSTAR_STYLE</java>
                        <tf>SCRIPT_STYLE</tf>
                        <imports>SCRIPT_STYLE</imports>
                        <factories>SCRIPT_STYLE</factories>
                        <cloudprovider>SCRIPT_STYLE</cloudprovider>
                    </mapping>
                </configuration>
                <executions>
                    <execution>
                        <id>check-license-headers</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-build-environment</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[21,)</version>
                                </requireJavaVersion>
                                <requireMavenVersion>
                                    <version>[3.9,)</version>
                                </requireMavenVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
