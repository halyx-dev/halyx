    <name>Halyx :: Parent</name>
    <description>Halyx: one Java API for storage, NoSQL, messaging, streams, SQL, caches and secrets on AWS, Azure and Google Cloud — a portable library over the clouds' own SDKs.</description>
    <!-- The modules share the project's URL and SCM; without these attributes Maven appends each artifactId. -->
    <url>https://halyx.dev</url>
    <inceptionYear>2026</inceptionYear>

    <licenses>
        <license>
            <name>Apache-2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>kamranzafar</id>
            <name>Kamran Zafar</name>
            <email>kamran@kamranzafar.org</email>
            <url>https://github.com/kamranzafar</url>
        </developer>
    </developers>

    <scm child.scm.connection.inherit.append.path="false"
         child.scm.developerConnection.inherit.append.path="false"
         child.scm.url.inherit.append.path="false">
