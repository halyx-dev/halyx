<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.kamranzafar</groupId>
    <artifactId>cirrus-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Cirrus :: Parent</name>
    <description>Cloud-agnostic Java API for storage, SQL, search and cache across AWS, Azure and GCP.</description>

    <modules>
        <module>cirrus-bom</module>
        <module>cirrus-core</module>
        <module>cirrus-tck</module>
        <module>cirrus-redis</module>
        <module>cirrus-sql</module>
        <module>cirrus-aws</module>
        <module>cirrus-azure</module>
        <module>cirrus-gcp</module>
        <module>cirrus-vault</module>
        <module>cirrus-spring-boot-autoconfigure</module>
        <module>cirrus-spring-boot-starter</module>
        <module>cirrus-spring-boot4-tests</module>
        <module>cirrus-benchmarks</module>
    </modules>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Cloud SDKs (managed through their own BOMs) -->
        <aws-sdk.version>2.55.14</aws-sdk.version>
        <azure-sdk-bom.version>1.3.8</azure-sdk-bom.version>
        <gcp-libraries-bom.version>26.90.0</gcp-libraries-bom.version>
        <!-- Not in libraries-bom yet; 0.43.0 is from the same google-cloud-java release (1.93.0) -->
        <gcp-parametermanager.version>0.43.0</gcp-parametermanager.version>
        <!-- Needed by the Apache HTTP transport, which Google's BOM ships without it; same as Spring 7 -->
        <commons-logging.version>1.3.6</commons-logging.version>

        <!--
          Spring Boot, imported only by the Spring modules so it never changes SDK dependency versions.
          The auto-configuration is compiled against the oldest supported line (3.5) and tested on both.
        -->
        <spring-boot3.version>3.5.16</spring-boot3.version>
        <spring-boot4.version>4.1.1</spring-boot4.version>
        <!-- Jackson 3 (tools.jackson), Boot 4's JSON library; compile-only for the cache codec -->
        <jackson3.version>3.1.5</jackson3.version>

        <!-- Redis/Valkey client: the 6.x line stays on Netty 4.1, like the AWS and Azure SDKs -->
        <lettuce.version>6.8.2.RELEASE</lettuce.version>
        <!-- SQL: the pool Spring Boot 3.5 ships (Boot 4 brings 7.x, which is API compatible), and test drivers -->
        <hikaricp.version>6.3.3</hikaricp.version>
        <postgresql.version>42.7.11</postgresql.version>
        <mysql-connector-j.version>9.7.0</mysql-connector-j.version>
        <mssql-jdbc.version>12.10.2.jre11</mssql-jdbc.version>
        <valkey.image>valkey/valkey:9.1.2-alpine</valkey.image>
        <vault.image>hashicorp/vault:2.1.2</vault.image>

        <!-- Common -->
        <slf4j.version>2.0.20</slf4j.version>

        <!-- Test -->
        <junit.version>6.1.3</junit.version>
        <assertj.version>3.27.7</assertj.version>
        <testcontainers.version>2.0.5</testcontainers.version>

        <!-- Floci emulator images used by the provider integration tests -->
        <floci.aws.image>floci/floci:2.2.0</floci.aws.image>
        <floci.azure.image>floci/floci-az:0.14.0</floci.azure.image>
        <floci.gcp.image>floci/floci-gcp:0.10.0</floci.gcp.image>

        <!-- Plugins -->
        <maven-compiler-plugin.version>3.15.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.5.6</maven-surefire-plugin.version>
        <maven-failsafe-plugin.version>3.5.6</maven-failsafe-plugin.version>
        <maven-jar-plugin.version>3.5.0</maven-jar-plugin.version>
        <maven-enforcer-plugin.version>3.6.3</maven-enforcer-plugin.version>
        <build-helper-maven-plugin.version>3.6.2</build-helper-maven-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Cirrus modules -->
            <dependency>
                <groupId>org.kamranzafar</groupId>
                <artifactId>cirrus-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.kamranzafar</groupId>
                <artifactId>cirrus-tck</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.kamranzafar</groupId>
                <artifactId>cirrus-redis</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.kamranzafar</groupId>
                <artifactId>cirrus-sql</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.kamranzafar</groupId>
                <artifactId>cirrus-aws</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.google.cloud</groupId>
                <artifactId>google-cloud-parametermanager</artifactId>
                <version>${gcp-parametermanager.version}</version>
            </dependency>
            <dependency>
                <groupId>com.google.api.grpc</groupId>
                <artifactId>grpc-google-cloud-parametermanager-v1</artifactId>
                <version>${gcp-parametermanager.version}</version>
            </dependency>
            <dependency>
                <groupId>commons-logging</groupId>
                <artifactId>commons-logging</artifactId>
                <version>${commons-logging.version}</version>
            </dependency>
            <dependency>
                <groupId>com.zaxxer</groupId>
                <artifactId>HikariCP</artifactId>
                <version>${hikaricp.version}</version>
            </dependency>
            <dependency>
                <groupId>org.postgresql</groupId>
                <artifactId>postgresql</artifactId>
                <version>${postgresql.version}</version>
            </dependency>
            <dependency>
                <groupId>com.mysql</groupId>
                <artifactId>mysql-connector-j</artifactId>
                <version>${mysql-connector-j.version}</version>
            </dependency>
            <dependency>
                <groupId>com.microsoft.sqlserver</groupId>
                <artifactId>mssql-jdbc</artifactId>
                <version>${mssql-jdbc.version}</version>
            </dependency>
            <dependency>
                <groupId>io.lettuce</groupId>
                <artifactId>lettuce-core</artifactId>
                <version>${lettuce.version}</version>
            </dependency>
            <dependency>
                <groupId>org.kamranzafar</groupId>
                <artifactId>cirrus-spring-boot-autoconfigure</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.kamranzafar</groupId>
                <artifactId>cirrus-vault</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Cloud SDK BOMs -->
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${aws-sdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.azure</groupId>
                <artifactId>azure-sdk-bom</artifactId>
                <version>${azure-sdk-bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.google.cloud</groupId>
                <artifactId>libraries-bom</artifactId>
                <version>${gcp-libraries-bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Test BOMs -->
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-api</artifactId>
                <version>${slf4j.version}</version>
            </dependency>
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-simple</artifactId>
                <version>${slf4j.version}</version>
            </dependency>
            <dependency>
                <groupId>org.assertj</groupId>
                <artifactId>assertj-core</artifactId>
                <version>${assertj.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                        <parameters>true</parameters>
                        <compilerArgs>
                            <arg>-Xlint:all,-processing,-serial</arg>
                        </compilerArgs>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>${maven-failsafe-plugin.version}</version>
                    <configuration>
                        <systemPropertyVariables>
                            <floci.aws.image>${floci.aws.image}</floci.aws.image>
                            <floci.azure.image>${floci.azure.image}</floci.azure.image>
                            <floci.gcp.image>${floci.gcp.image}</floci.gcp.image>
                            <valkey.image>${valkey.image}</valkey.image>
                            <vault.image>${vault.image}</vault.image>
                        </systemPropertyVariables>
                    </configuration>
                    <executions>
                        <execution>
                            <goals>
                                <goal>integration-test</goal>
                                <goal>verify</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>${maven-jar-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <version>${maven-enforcer-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>build-helper-maven-plugin</artifactId>
                    <version>${build-helper-maven-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-build-environment</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[21,)</version>
                                </requireJavaVersion>
                                <requireMavenVersion>
                                    <version>[3.9,)</version>
                                </requireMavenVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
