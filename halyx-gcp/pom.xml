<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.halyx</groupId>
        <artifactId>halyx-parent</artifactId>
        <version>1.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>halyx-gcp</artifactId>
    <name>Halyx :: GCP</name>
    <description>Halyx, the multi-cloud Java library: the Google Cloud provider (Cloud Storage, Firestore, Pub/Sub, Secret Manager, Parameter Manager, and IAM login for Memorystore and Cloud SQL).</description>

    <properties>
        <halyx.module.name>dev.halyx.gcp</halyx.module.name>
    </properties>

    <dependencies>
        <dependency>
            <groupId>dev.halyx</groupId>
            <artifactId>halyx-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.google.cloud</groupId>
            <artifactId>google-cloud-storage</artifactId>
        </dependency>
        <!-- Pooled Apache transport for GCS; the default HttpURLConnection keeps only 5 idle connections -->
        <dependency>
            <groupId>com.google.http-client</groupId>
            <artifactId>google-http-client-apache-v2</artifactId>
        </dependency>
        <!-- Apache HttpClient 4 logs through commons-logging, which Google excludes; 1.3 routes to SLF4J -->
        <dependency>
            <groupId>commons-logging</groupId>
            <artifactId>commons-logging</artifactId>
        </dependency>
        <!-- Secrets -->
        <dependency>
            <groupId>com.google.cloud</groupId>
            <artifactId>google-cloud-secretmanager</artifactId>
        </dependency>
        <!-- NoSQL -->
        <dependency>
            <groupId>com.google.cloud</groupId>
            <artifactId>google-cloud-firestore</artifactId>
        </dependency>
        <!-- Messaging -->
        <dependency>
            <groupId>com.google.cloud</groupId>
            <artifactId>google-cloud-pubsub</artifactId>
        </dependency>
        <dependency>
            <groupId>com.google.cloud</groupId>
            <artifactId>google-cloud-eventarc-publishing</artifactId>
        </dependency>
        <dependency>
            <groupId>com.google.cloud</groupId>
            <artifactId>google-cloud-parametermanager</artifactId>
        </dependency>
        <!-- Caches: shared Redis driver, with IAM access tokens for Memorystore -->
        <dependency>
            <groupId>dev.halyx</groupId>
            <artifactId>halyx-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.halyx</groupId>
            <artifactId>halyx-sql</artifactId>
        </dependency>
        <!-- Streams: the shared Kafka driver, for Managed Service for Apache Kafka with Google IAM tokens -->
        <dependency>
            <groupId>dev.halyx</groupId>
            <artifactId>halyx-kafka</artifactId>
        </dependency>
        <!--
          Security fixes: the Google Cloud libraries' Jackson and Guava, held at the patched versions halyx-parent manages. Declared here so
          they are nearer than the copies the libraries bring, and win in applications too.
        -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
        </dependency>

        <!-- Tests: TCK against the Floci emulator in Docker (run with mvn verify) -->
        <dependency>
            <groupId>dev.halyx</groupId>
            <artifactId>halyx-tck</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- R2DBC logins in the real-cloud SQL tests -->
        <dependency>
            <groupId>dev.halyx</groupId>
            <artifactId>halyx-r2dbc</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>r2dbc-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.asyncer</groupId>
            <artifactId>r2dbc-mysql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Fake Parameter Manager gRPC server for tests (there is no emulator) -->
        <dependency>
            <groupId>com.google.api.grpc</groupId>
            <artifactId>grpc-google-cloud-parametermanager-v1</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- No emulator has Managed Kafka: the stream TCK runs through this provider against Apache Kafka -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-kafka</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- JDBC drivers and Cloud SQL connectors for the real Cloud SQL tests (tier 2) -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.google.cloud.sql</groupId>
            <artifactId>postgres-socket-factory</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.google.cloud.sql</groupId>
            <artifactId>mysql-socket-factory-connector-j-8</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
