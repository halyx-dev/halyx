<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.kamranzafar.halyx</groupId>
        <artifactId>halyx-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <!--
      Shared stream driver for every provider: Kafka producers and consumers whose clients log in with a password
      or with tokens from a provider's KafkaCredentialsSource (SASL OAUTHBEARER).
    -->
    <artifactId>halyx-kafka</artifactId>
    <name>Halyx :: Kafka</name>
    <description>Halyx, the multi-cloud Java library: the Kafka stream driver shared by the AWS, Azure and Google Cloud providers, for Amazon MSK, Azure Event Hubs and Google Cloud Managed Service for Apache Kafka.</description>

    <dependencies>
        <dependency>
            <groupId>org.kamranzafar.halyx</groupId>
            <artifactId>halyx-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.kafka</groupId>
            <artifactId>kafka-clients</artifactId>
        </dependency>

        <!-- Tests: the stream TCK against Apache Kafka in Docker (run with mvn verify) -->
        <dependency>
            <groupId>org.kamranzafar.halyx</groupId>
            <artifactId>halyx-tck</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-kafka</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
