# Declares Halyx as a Spring Data module, so that next to another module (Spring Data JPA, Cosmos, MongoDB and so on)
# Spring Data switches to strict configuration: each module then claims only the repositories that extend its own
# repository types or whose entities carry its annotations.
org.springframework.data.repository.core.support.RepositoryFactorySupport=\
  dev.halyx.spring.data.document.repository.HalyxRepositoryFactory,\
  dev.halyx.spring.data.document.repository.HalyxReactiveRepositoryFactory
