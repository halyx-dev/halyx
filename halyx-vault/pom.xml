<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.halyx</groupId>
        <artifactId>halyx-parent</artifactId>
        <version>1.0.1</version>
    </parent>

    <artifactId>halyx-vault</artifactId>
    <name>Halyx :: HashiCorp Vault</name>
    <description>Halyx, the multi-cloud Java library: the HashiCorp Vault KV v2 provider for parameters and secrets. It uses the JDK HTTP client and a built-in JSON codec, so it adds no third-party dependencies that could clash with the cloud SDKs.</description>

    <properties>
        <halyx.module.name>dev.halyx.vault</halyx.module.name>
    </properties>

    <dependencies>
        <dependency>
            <groupId>dev.halyx</groupId>
            <artifactId>halyx-core</artifactId>
        </dependency>

        <dependency>
            <groupId>dev.halyx</groupId>
            <artifactId>halyx-tck</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
