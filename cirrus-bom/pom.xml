<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      Deliberately has no parent: importing this BOM must only bring in Cirrus's own
      artifacts, not the cloud SDK BOMs managed by cirrus-parent.
    -->
    <groupId>org.kamranzafar.cirrus</groupId>
    <artifactId>cirrus-bom</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Cirrus :: BOM</name>

    <licenses>
        <license>
            <name>Apache-2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.kamranzafar.cirrus</groupId>
                <artifactId>cirrus-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.kamranzafar.cirrus</groupId>
                <artifactId>cirrus-tck</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.kamranzafar.cirrus</groupId>
                <artifactId>cirrus-redis</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.kamranzafar.cirrus</groupId>
                <artifactId>cirrus-sql</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.kamranzafar.cirrus</groupId>
                <artifactId>cirrus-aws</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.kamranzafar.cirrus</groupId>
                <artifactId>cirrus-azure</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.kamranzafar.cirrus</groupId>
                <artifactId>cirrus-gcp</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.kamranzafar.cirrus</groupId>
                <artifactId>cirrus-vault</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.kamranzafar.cirrus</groupId>
                <artifactId>cirrus-spring-boot-autoconfigure</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.kamranzafar.cirrus</groupId>
                <artifactId>cirrus-spring-boot-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
